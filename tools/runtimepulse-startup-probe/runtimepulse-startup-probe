def attach_bcc_go_uprobes(go_uprobes: list[GoUprobeSpec]):
    if not go_uprobes:
        return None, {}
    try:
        from bcc import BPF
    except ImportError as exc:
        raise SystemExit("python3-bcc is required for --enable-go-uprobes") from exc
    bpf = BPF(text=build_bcc_go_uprobe_program(go_uprobes))
    symbol_by_index: dict[int, GoUprobeSpec] = {}
    for idx, spec in enumerate(go_uprobes):
        bpf.attach_uprobe(name=spec.binary.encode(), addr=spec.attach_offset, fn_name=f"trace_entry_{idx}".encode())
        if spec.attach_return:
            bpf.attach_uretprobe(name=spec.binary.encode(), addr=spec.attach_offset, fn_name=f"trace_return_{idx}".encode())
        symbol_by_index[idx] = spec
    trace = bpf.trace_open(nonblocking=True)
    fd = trace.fileno()
    flags = fcntl.fcntl(fd, fcntl.F_GETFL)
    fcntl.fcntl(fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
    return bpf, symbol_by_index


def read_bcc_go_uprobe_lines(bpf, symbol_by_index: dict[int, GoUprobeSpec]) -> list[str]:
    if bpf is None:
        return []
    trace = bpf.trace_open(nonblocking=True)
    lines: list[str] = []
    pattern = re.compile(r"^\s*(?P<comm>.*?)\s*[-]\s*\d+\s+\[.*?\]\s+[^:]+:\s+(?:(?P<ip>0x[0-9a-fA-F]+):\s+)?(?:bpf_trace_printk:\s+)?(?P<kind>RP_GO_UPROBE_(?:ENTER|EXIT))\s+(?P<idx>\d+)\s+(?P<ts>\d+)\s+(?P<pid>\d+)\s+(?P<tid>\d+)")
    meta_pattern = re.compile(r"^\s*(?P<comm>.*?)\s*[-]\s*\d+\s+\[.*?\]\s+[^:]+:\s+(?:(?P<ip>0x[0-9a-fA-F]+):\s+)?(?:bpf_trace_printk:\s+)?RP_GO_UPROBE_META\s+(?P<pid>\d+)\s+(?P<tid>\d+)\s+(?P<field>\S+)\s+(?P<value>.*)$")
    monotonic_epoch_ns = time.time_ns() - time.monotonic_ns()
    while True:
        try:
            raw = trace.readline(4096)
        except (BlockingIOError, OSError):
            break
        if not raw:
            break
        text = raw.decode("utf-8", "replace").strip()
        meta_match = meta_pattern.match(text)
        if meta_match:
            # Metadata lines intentionally omit the symbol index because Linux
            # trace_printk only reliably formats three dynamic values.  Attach
            # them by pid/tid to the following RunPodSandbox entry.
            timestamp_ns = time.time_ns()
            lines.append(
                f"RP_GO_UPROBE_META\t{timestamp_ns}\t{meta_match.group('pid')}\t{meta_match.group('tid')}\t"
                f"{meta_match.group('comm').strip()}\tRunPodSandbox\tunknown\t"
                f"{meta_match.group('field')}\t{meta_match.group('value').strip()}\n"
            )
            continue
        match = pattern.match(text)
        if not match:
            continue
        if not symbol_by_index:
            continue
        spec = symbol_by_index.get(int(match.group("idx")))
        if not spec:
            continue
        timestamp_ns = int(match.group('ts')) + monotonic_epoch_ns
        lines.append(
            f"{match.group('kind')}\t{timestamp_ns}\t{match.group('pid')}\t{match.group('tid')}\t"
            f"{match.group('comm').strip()}\t{spec.function}\t{spec.symbol}\t{spec.binary}\n"
        )
    return lines


def run_bpftrace(args: argparse.Namespace, candidates: set[str], go_uprobes: list[GoUprobeSpec] | None = None) -> list[str]:
    go_uprobes = go_uprobes or []
    bcc_bpf, bcc_symbols = attach_bcc_go_uprobes(go_uprobes) if go_uprobes else (None, {})
    program = build_bpftrace_program(candidates, args.duration_ms, args.argv_slots, args.env_slots, [])
    bpftrace = shutil.which(args.bpftrace) or args.bpftrace
    if not bpftrace or not os.path.exists(bpftrace):
        raise SystemExit(f"bpftrace not found: {args.bpftrace}")

    with tempfile.NamedTemporaryFile("w", prefix="runtimepulse-startup-probe-", suffix=".bt", delete=False) as handle:
        handle.write(program)
        script_path = handle.name

    env = os.environ.copy()
    env.setdefault("BPFTRACE_STRLEN", str(args.strlen))
    cmd = [bpftrace, "-q", script_path]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, encoding="utf-8", errors="replace", env=env)
    lines: list[str] = []
    try:
        assert proc.stdout is not None
        deadline = time.time() + max(args.duration_ms / 1000.0 + 5.0, 6.0)
        while time.time() < deadline:
            line = proc.stdout.readline()
            if line:
                if line.startswith("RP_STARTUP_PROBE_READY") and args.ready_file:
                    Path(args.ready_file).write_text(str(proc.pid))
                if line.startswith("RP_"):
                    lines.append(line)
                lines.extend(read_bcc_go_uprobe_lines(bcc_bpf, bcc_symbols))
                continue
            lines.extend(read_bcc_go_uprobe_lines(bcc_bpf, bcc_symbols))
            if proc.poll() is not None:
                break
            time.sleep(0.01)
        if proc.poll() is None:
            proc.send_signal(signal.SIGINT)
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
        if bcc_bpf is not None:
            time.sleep(0.05)
        lines.extend(read_bcc_go_uprobe_lines(bcc_bpf, bcc_symbols))
        stderr = proc.stderr.read() if proc.stderr else ""
        if proc.returncode not in (0, None) and not lines:
            raise SystemExit(f"bpftrace failed with {proc.returncode}: {stderr.strip()}")
    finally:
        try:
            os.unlink(script_path)
        except FileNotFoundError:
            pass
    return lines


def event_sandbox_key(event: dict[str, object]) -> str:
    for key in ("sandboxId", "criSandboxId", "containerdId"):
        value = str(event.get(key, "") or "").strip()
        if value:
            return value
    return "unknown"


def event_identity_fields(event: dict[str, object]) -> dict[str, str]:
    attrs = event.get("attributes") or {}
    attrs = attrs if isinstance(attrs, dict) else {}
    fields = {
        "namespace": str(event.get("namespace") or attrs.get("k8s.namespace") or attrs.get("cni.args.K8S_POD_NAMESPACE") or "").strip(),
        "podName": str(event.get("podName") or attrs.get("k8s.pod") or attrs.get("cni.args.K8S_POD_NAME") or "").strip(),
        "podUid": str(event.get("podUid") or attrs.get("k8s.pod_uid") or attrs.get("cni.args.K8S_POD_UID") or "").strip(),
        "containerName": str(event.get("containerName") or attrs.get("k8s.container") or "").strip(),
        "runtimeHandler": str(event.get("runtimeHandler") or attrs.get("cri.runtime_handler") or attrs.get("runtime.handler") or "").strip(),
    }
    return {key: value for key, value in fields.items() if value}


def propagate_sandbox_identity_fields(events: list[dict[str, object]]) -> list[dict[str, object]]:
    identity_by_sandbox: dict[str, dict[str, str]] = {}
    for event in events:
        key = event_sandbox_key(event)
        if key == "unknown":
            continue
        identity = event_identity_fields(event)
        if not identity:
            continue
        merged = identity_by_sandbox.setdefault(key, {})
        for field, value in identity.items():
            merged.setdefault(field, value)
    if not identity_by_sandbox:
        return events

    attr_for_top_level = {
        "namespace": "k8s.namespace",
        "podName": "k8s.pod",
        "podUid": "k8s.pod_uid",
        "containerName": "k8s.container",
        "runtimeHandler": "cri.runtime_handler",
    }
    result: list[dict[str, object]] = []
    for event in events:
        key = event_sandbox_key(event)
        identity = identity_by_sandbox.get(key)
        if not identity:
            result.append(event)
            continue
        updated = dict(event)
        attrs = dict(updated.get("attributes") or {})
        changed = False
        for field, value in identity.items():
            if value and not str(updated.get(field) or "").strip():
                updated[field] = value
                changed = True
            attr_key = attr_for_top_level.get(field)
            if attr_key and value and not str(attrs.get(attr_key) or "").strip():
                attrs[attr_key] = value
                changed = True
        if changed:
            updated["attributes"] = attrs
        result.append(updated)
    return result


def runtime_type_from_events(events: list[dict[str, object]], default: str) -> str:
    runtime_type = default or "unknown"
    for event in events:
        runtime_type = choose_runtime_type(runtime_type, str(event.get("runtimeType", "") or ""))
    return runtime_type


def first_event_value(events: list[dict[str, object]], *keys: str) -> str:
    for event in events:
        for key in keys:
            value = str(event.get(key, "") or "").strip()
            if value:
                return value
    return ""



def report_time_window(events: list[dict[str, object]]) -> tuple[str, str, float | None]:
    timestamps = [str(event.get("timestamp", "") or "") for event in events]
    timestamps = [timestamp for timestamp in timestamps if timestamp]
    if not timestamps:
        return "", "", None
    start_time = min(timestamps)
    end_time = max(timestamps)
    start_dt = parse_iso8601(start_time)
    end_dt = parse_iso8601(end_time)
    duration_ms = None
    if start_dt and end_dt:
        duration_ms = max((end_dt - start_dt).total_seconds() * 1000.0, 1.0)
    return start_time, end_time, duration_ms


def parse_iso8601(value: str) -> datetime | None:
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def report_from_events(
    events: list[dict[str, object]],
    runtime_type: str,
    sandbox_id: str,
    cri_sandbox_id: str,
    source: str,
) -> dict[str, object]:
    report_sandbox_id = sandbox_id or first_event_value(
        events, "sandboxId", "criSandboxId", "containerdId"
    )
    report_cri_sandbox_id = cri_sandbox_id or first_event_value(
        events, "criSandboxId", "sandboxId", "containerdId"
    )
    start_time, end_time, duration_ms = report_time_window(events)
    report = {
        "source": source,
        "timestamp": utc_now(),
        "runtimeType": runtime_type_from_events(events, runtime_type),
        "sandboxId": report_sandbox_id,
        "criSandboxId": report_cri_sandbox_id,
        "containerdId": first_event_value(events, "containerdId", "criSandboxId", "sandboxId"),
        "summary": summarize_events(events),
        "events": events,
    }
    if start_time and end_time and duration_ms is not None:
        report["startTime"] = start_time
        report["endTime"] = end_time
        report["durationMs"] = duration_ms
    return report


def pending_go_uprobe_summary(pending_events: list[dict[str, object]], assigned_count: int) -> dict[str, object]:
    functions = sorted({str(event.get("function") or "unknown") for event in pending_events})
    debug_events = [event for event in pending_events if str((event.get("attributes") or {}).get("startup.probe.debug_boundary") or "").lower() == "true"]
    return {
        "pendingGoUprobeEventCount": float(len(pending_events)),
        "assignedPendingGoUprobeEventCount": float(assigned_count),
        "unassignedPendingGoUprobeEventCount": float(max(0, len(pending_events) - assigned_count)),
        "pendingGoUprobeFunctions": functions[:16],
        "pendingDebugGoUprobeEventCount": float(len(debug_events)),
    }


def attach_pending_go_uprobes_to_reports(reports: list[dict[str, object]], pending_events: list[dict[str, object]]) -> int:
    if not reports or not pending_events:
        return 0
    assigned_count = 0
    concrete_reports = [report for report in reports if report.get("sandboxId") or report.get("criSandboxId")]
    if len(concrete_reports) == 1:
        concrete_reports[0].setdefault("events", []).extend(pending_events)
        assigned_count = len(pending_events)
        concrete_reports[0]["summary"] = summarize_events(concrete_reports[0].get("events") or [])
        window = report_time_window_for_events(concrete_reports[0].get("events") or [])
        if window:
            concrete_reports[0]["startTime"], concrete_reports[0]["endTime"], concrete_reports[0]["durationMs"] = window
        return assigned_count

    concrete_windows: list[tuple[datetime, datetime, dict[str, object]]] = []
    for report in concrete_reports:
        start = parse_iso8601(str(report.get("startTime", "") or ""))
        end = parse_iso8601(str(report.get("endTime", "") or ""))
        if start and end:
            concrete_windows.append((start - timedelta(seconds=2), end + timedelta(seconds=2), report))
    for event in pending_events:
        if str(event.get("role") or "").lower() == "cni" and len(concrete_reports) > 1:
            continue
        ts = event_time(event)
        matches = [report for start, end, report in concrete_windows if ts and start <= ts <= end]
        if len(matches) == 1:
            matches[0].setdefault("events", []).append(event)
            assigned_count += 1

    for report in concrete_reports:
        report["summary"] = summarize_events(report.get("events") or [])
        window = report_time_window_for_events(report.get("events") or [])
        if window:
            report["startTime"], report["endTime"], report["durationMs"] = window
    return assigned_count


def grouped_reports(
    events: list[dict[str, object]],
    runtime_type: str,
    sandbox_id: str,
    cri_sandbox_id: str,
    source: str,
) -> list[dict[str, object]]:
    groups: dict[str, list[dict[str, object]]] = {}
    pending_go_events: list[dict[str, object]] = []
    for event in events:
        if event_sandbox_key(event) == "unknown" and is_pending_window_go_uprobe(event):
            pending_go_events.append(event)
            continue
        groups.setdefault(event_sandbox_key(event), []).append(event)
    if not groups:
        return [report_from_events([], runtime_type, sandbox_id, cri_sandbox_id, source)]
    reports = [
        report_from_events(group_events, runtime_type, "", "", source)
        for _key, group_events in sorted(groups.items())
    ]
    assigned_pending_go = attach_pending_go_uprobes_to_reports(reports, pending_go_events)
    filtered = [report for report in reports if report.get("events") or report.get("sandboxId") or report.get("criSandboxId")]
    if pending_go_events:
        quality = pending_go_uprobe_summary(pending_go_events, assigned_pending_go)
        for report in filtered:
            summary = dict(report.get("summary") or {})
            summary.update(quality)
            report["summary"] = summary
    return filtered


def emit_report(
    events: list[dict[str, object]],
    summary: dict[str, float],
    runtime_type: str,
    sandbox_id: str,
    cri_sandbox_id: str,
    source: str,
    group_by_sandbox: bool = True,
) -> None:
    if group_by_sandbox:
        reports = grouped_reports(events, runtime_type, sandbox_id, cri_sandbox_id, source)
        if len(reports) == 1:
            print(json.dumps(reports[0], separators=(",", ":")))
        else:
            print(
                json.dumps(
                    {"source": source, "timestamp": utc_now(), "reports": reports},
                    separators=(",", ":"),
                )
            )
        return

    report = {
        "source": source,
        "timestamp": utc_now(),
        "runtimeType": runtime_type or "unknown",
        "sandboxId": sandbox_id or cri_sandbox_id,
        "criSandboxId": cri_sandbox_id,
        "containerdId": cri_sandbox_id,
        "summary": summary,
        "events": events,
    }
    print(json.dumps(report, separators=(",", ":")))


def export_command(args: argparse.Namespace) -> None:
    global EXTRA_CONTAINERD_CONFIGS
    EXTRA_CONTAINERD_CONFIGS = split_csv(args.containerd_config or [])
    candidates = candidate_names(existing_files(args.include_binary))
    cni_dirs = args.cni_bin_dir or DEFAULT_CNI_BIN_DIRS
    cni_binaries = discover_cni_binaries(cni_dirs)
    runtime_binaries = existing_files(args.runtime_binary or DEFAULT_RUNTIME_BINARIES)
    helper_binaries = existing_files(DEFAULT_HELPER_BINARIES if args.include_helpers else [])
    candidates.update(candidate_names(cni_binaries))
    candidates.update(candidate_names(runtime_binaries))
    candidates.update(candidate_names(helper_binaries))

    go_uprobes: list[GoUprobeSpec] = []
    if args.enable_go_uprobes:
        explicit_patterns = bool(args.go_uprobe_symbol)
        patterns = args.go_uprobe_symbol or DEFAULT_GO_UPROBE_SYMBOL_PATTERNS
        attach_return = args.enable_go_uretprobes
        go_uprobes = discover_go_uprobes(args.containerd_binary, patterns, attach_return)
        if args.enable_cni_go_uprobes:
            go_uprobes.extend(discover_go_uprobes(args.containerd_binary, args.cni_go_uprobe_symbol or DEFAULT_GO_CNI_UPROBE_SYMBOL_PATTERNS, attach_return))
        if args.enable_runtime_go_uprobes:
            runtime_patterns = args.runtime_go_uprobe_symbol or DEFAULT_GO_RUNTIME_UPROBE_SYMBOL_PATTERNS
            runtime_binaries = unique_realpaths(existing_files(args.runtime_uprobe_binary or DEFAULT_RUNTIME_UPROBE_BINARIES))
            for runtime_binary in runtime_binaries:
                go_uprobes.extend(discover_go_uprobes(runtime_binary, runtime_patterns, attach_return))
        if go_uprobes and not explicit_patterns:
            runpod = go_uprobes[:1]
            extra = [spec for spec in go_uprobes[1:] if go_uprobe_role(spec.function) != "cri"]
            go_uprobes = runpod + extra
        if not go_uprobes:
            raise SystemExit(f"no Go uprobe symbols matched in {args.containerd_binary}: {patterns}")

    if args.from_bpftrace_log:
        lines = Path(args.from_bpftrace_log).read_text().splitlines(True)
    else:
        lines = run_bpftrace(args, candidates, go_uprobes)

    namespaces = set(split_csv(args.containerd_namespace)) if args.containerd_namespace else None
    events, summary, runtime_type, sandbox_id, cri_sandbox_id = collect_from_stream(
        lines,
        args.argv_slots,
        args.env_slots,
        args.runtime_type,
        args.sandbox_id,
        namespaces,
    )
    emit_report(
        events,
        summary,
        runtime_type,
        sandbox_id,
        cri_sandbox_id,
        args.source,
        not args.no_group_by_sandbox,
    )


