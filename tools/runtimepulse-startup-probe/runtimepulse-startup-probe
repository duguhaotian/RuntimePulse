def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def basename(value: str | None) -> str:
    if not value:
        return ""
    return os.path.basename(value.split()[0])


def sanitize_id(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]+", "-", value.strip()).strip("-").lower() or "unknown"


def split_csv(values: Iterable[str]) -> list[str]:
    result: list[str] = []
    for value in values:
        for item in value.split(","):
            item = item.strip()
            if item:
                result.append(item)
    return result


def existing_files(paths: Iterable[str]) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for path in paths:
        if not path or path in seen:
            continue
        if os.path.exists(path):
            seen.add(path)
            result.append(path)
    return result


def discover_cni_binaries(dirs: Iterable[str]) -> list[str]:
    result: list[str] = []
    for directory in dirs:
        try:
            for item in Path(directory).iterdir():
                if item.is_file() and os.access(item, os.X_OK):
                    result.append(str(item))
        except FileNotFoundError:
            continue
        except PermissionError:
            continue
    return existing_files(result)


def unique_realpaths(paths: Iterable[str]) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for path in paths:
        real = os.path.realpath(path)
        if real in seen:
            continue
        seen.add(real)
        result.append(path)
    return result


def candidate_names(paths: Iterable[str]) -> set[str]:
    names: set[str] = set()
    for path in paths:
        names.add(path)
        base = basename(path)
        if base:
            names.add(base)
    return names


def env_flag(name: str, default: bool = False) -> bool:
    value = os.getenv(name)
    if value is None or value == "":
        return default
    return value.strip().lower() in {"1", "true", "yes", "y", "on"}


def resolve_binary(path_or_name: str) -> str:
    if not path_or_name:
        return ""
    if os.path.isabs(path_or_name):
        return path_or_name
    return shutil.which(path_or_name) or path_or_name


def parse_elf_load_segments(data: bytes) -> list[tuple[int, int, int, int]]:
    if len(data) < 64 or data[:4] != b"\x7fELF":
        return []
    if data[4] != 2 or data[5] != 1:
        return []
    e_phoff = struct.unpack_from("<Q", data, 32)[0]
    e_phentsize = struct.unpack_from("<H", data, 54)[0]
    e_phnum = struct.unpack_from("<H", data, 56)[0]
    segments: list[tuple[int, int, int, int]] = []
    for idx in range(e_phnum):
        offset = e_phoff + idx * e_phentsize
        if offset + 56 > len(data):
            break
        p_type = struct.unpack_from("<I", data, offset)[0]
        if p_type != 1:
            continue
        p_offset, p_vaddr, _p_paddr, p_filesz, p_memsz, _p_align = struct.unpack_from("<QQQQQQ", data, offset + 8)
        segments.append((p_offset, p_vaddr, p_filesz, p_memsz))
    return segments


def elf_type(data: bytes) -> int:
    if len(data) < 18 or data[:4] != b"\x7fELF" or data[5] != 1:
        return 0
    return struct.unpack_from("<H", data, 16)[0]


def bcc_attach_address(address: int, data: bytes, segments: list[tuple[int, int, int, int]]) -> int:
    # BCC expects virtual addresses for ET_EXEC binaries and file-load-relative
    # offsets for PIE/ET_DYN binaries. Go pclntab entries are virtual PCs.
    if elf_type(data) == 2:  # ET_EXEC
        return address
    for p_offset, p_vaddr, p_filesz, p_memsz in segments:
        if p_vaddr <= address < p_vaddr + p_memsz:
            candidate = p_offset + (address - p_vaddr)
            if candidate < p_offset + max(p_filesz, 1):
                return candidate
    return address


def c_string(data: bytes, offset: int) -> str:
    if offset < 0 or offset >= len(data):
        return ""
    end = data.find(b"\x00", offset)
    if end < 0:
        return ""
    return data[offset:end].decode("utf-8", "replace")


def find_go_pclntab(data: bytes) -> tuple[int, int, int, int, int] | None:
    for offset in range(0, len(data) - 72):
        magic = struct.unpack_from("<I", data, offset)[0]
        if magic not in GO_PCLNTAB_MAGICS:
            continue
        pad1, pad2, min_lc, ptr_size = struct.unpack_from("<BBBB", data, offset + 4)
        if pad1 != 0 or pad2 != 0 or ptr_size not in {4, 8} or min_lc not in {1, 2, 4}:
            continue
        try:
            nfunc = struct.unpack_from("<Q", data, offset + 8)[0]
            text_start = struct.unpack_from("<Q", data, offset + 24)[0]
            funcname_offset = struct.unpack_from("<Q", data, offset + 32)[0]
            pcln_offset = struct.unpack_from("<Q", data, offset + 64)[0]
        except struct.error:
            continue
        if not (0 < nfunc < 2_000_000):
            continue
        if not (0 < funcname_offset < len(data) and 0 < pcln_offset < len(data)):
            continue
        functab = offset + pcln_offset
        if functab + 8 > len(data):
            continue
        return offset, nfunc, text_start, funcname_offset, pcln_offset
    return None


def discover_go_functions(binary: str) -> dict[str, tuple[int, int]]:
    data = Path(binary).read_bytes()
    header = find_go_pclntab(data)
    if not header:
        return {}
    base, nfunc, text_start, funcname_offset, pcln_offset = header
    name_base = base + funcname_offset
    functab = base + pcln_offset
    funcdata_base = base + pcln_offset
    segments = parse_elf_load_segments(data)
    functions: dict[str, tuple[int, int]] = {}
    for idx in range(nfunc):
        entry_offset = functab + idx * 8
        if entry_offset + 8 > len(data):
            break
        entry_delta, func_offset = struct.unpack_from("<II", data, entry_offset)
        funcdata = funcdata_base + func_offset
        if funcdata + 8 > len(data):
            continue
        name_offset = struct.unpack_from("<I", data, funcdata + 4)[0]
        name = c_string(data, name_base + name_offset)
        if not name:
            continue
        address = text_start + entry_delta
        functions[name] = (address, bcc_attach_address(address, data, segments))
    return functions


def symbol_matches(name: str, pattern: str) -> bool:
    if name == pattern or name.endswith(pattern):
        return True
    if pattern.startswith("regex:"):
        try:
            return re.search(pattern[len("regex:"):], name) is not None
        except re.error:
            return False
    return pattern in name


def short_go_function(symbol: str) -> str:
    lower = symbol.lower()
    if "runpodsandbox" in lower:
        return "RunPodSandbox"
    if "setuppodnetwork" in lower:
        return "CNISetup"
    if "setupserially" in symbol:
        return "CNISetupSerially"
    if "go-cni" in lower and re.search(r"\bSetup$|\.Setup$", symbol):
        return "CNISetup"
    if "containerd-shim-runc-v2" in lower and "(*init).create" in lower:
        return "OCIShimCreate"
    if "containerd-shim-runc-v2" in lower and "(*init).start" in lower:
        return "OCIShimStart"
    if "go-runc" in lower and "(*runc).create" in lower:
        return "OCIRuncCreate"
    if "go-runc" in lower and "(*runc).start" in lower:
        return "OCIRuncStart"
    if "containerd-shim-v2" in lower and "(*service).create" in lower:
        return "KataShimCreate"
    if "containerd-shim-v2" in lower and "(*service).start" in lower:
        return "KataShimStart"
    if "virtcontainers.createsandbox" in lower or "(*vcimpl).createsandbox" in lower:
        return "KataSandboxCreate"
    if "virtcontainers.(*sandbox).start" in lower:
        return "KataSandboxStart"
    if re.search(r"\bSetup$|\.Setup$", symbol):
        return "CNISetup"
    return symbol.rsplit("/", 1)[-1]


def go_uprobe_role(function: str) -> str:
    lower = function.lower()
    if lower.startswith("cni"):
        return "cni"
    if lower.startswith("kata"):
        return "kata"
    if lower.startswith("oci"):
        return "oci"
    return "cri"


def go_uprobe_span_name(function: str) -> str:
    lower = function.lower()
    if lower.startswith("cni"):
        return "cni.setup"
    if lower == "ocishimcreate":
        return "oci.shim.create"
    if lower == "ocishimstart":
        return "oci.shim.start"
    if lower == "ocirunccreate":
        return "oci.runc.create"
    if lower == "ociruncstart":
        return "oci.runc.start"
    if lower == "katashimcreate":
        return "kata.shim.create"
    if lower == "katashimstart":
        return "kata.shim.start"
    if lower == "katasandboxcreate":
        return "kata.sandbox.create"
    if lower == "katasandboxstart":
        return "kata.sandbox.start"
    return ""

def discover_go_uprobes(binary: str, patterns: Iterable[str], attach_return: bool = True) -> list[GoUprobeSpec]:
    resolved = resolve_binary(binary)
    if not resolved or not os.path.exists(resolved):
        return []
    functions = discover_go_functions(resolved)
    specs: list[GoUprobeSpec] = []
    used: set[str] = set()
    for pattern in patterns:
        matches = [name for name in functions if symbol_matches(name, pattern)]
        matches.sort(key=lambda name: (".func" in name or "deferwrap" in name, len(name), name))
        for name in matches:
            if name in used:
                continue
            address, attach_offset = functions[name]
            specs.append(GoUprobeSpec(resolved, name, address, attach_offset, short_go_function(name), attach_return))
            used.add(name)
            break
    return specs


def tracefs_path() -> Path:
    for candidate in TRACEFS_CANDIDATES:
        path = Path(candidate)
        if path.exists():
            return path
    return Path(TRACEFS_CANDIDATES[0])


def write_tracefs_line(path: Path, line: str, append: bool = True) -> None:
    flags = os.O_WRONLY
    if append:
        flags |= os.O_APPEND
    fd = os.open(path, flags)
    try:
        os.write(fd, line.encode("utf-8"))
    finally:
        os.close(fd)


def register_go_uprobe_tracepoints(specs: list[GoUprobeSpec], group: str = "runtimepulse_startup") -> list[tuple[str, GoUprobeSpec]]:
    if not specs:
        return []
    uprobe_events = tracefs_path() / "uprobe_events"
    registrations: list[tuple[str, GoUprobeSpec]] = []
    for idx, spec in enumerate(specs):
        safe = sanitize_id(spec.function or spec.symbol).replace("-", "_")[:32] or "go_uprobe"
        enter_event = f"{safe}_{idx}_enter"
        exit_event = f"{safe}_{idx}_exit"
        for event in (enter_event, exit_event):
            try:
                write_tracefs_line(uprobe_events, f"-:{group}/{event}\n")
            except OSError:
                pass
        write_tracefs_line(uprobe_events, f"p:{group}/{enter_event} {spec.binary}:0x{spec.attach_offset:x}\n")
        write_tracefs_line(uprobe_events, f"r:{group}/{exit_event} {spec.binary}:0x{spec.attach_offset:x}\n")
        registrations.append((enter_event, spec))
        registrations.append((exit_event, spec))
    return registrations

def unregister_go_uprobe_tracepoints(registrations: list[tuple[str, GoUprobeSpec]], group: str = "runtimepulse_startup") -> None:
    if not registrations:
        return
    uprobe_events = tracefs_path() / "uprobe_events"
    for event, _spec in registrations:
        try:
            write_tracefs_line(uprobe_events, f"-:{group}/{event}\n")
        except OSError:
            pass

def timestamp_from_unix_nanos(value: int) -> str:
    return datetime.fromtimestamp(value / 1_000_000_000, timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def bpftrace_string(value: str) -> str:
    return json.dumps(value)


def build_bpftrace_program(candidates: set[str], duration_ms: int, argv_slots: int, env_slots: int, go_uprobes: list[GoUprobeSpec] | None = None) -> str:
    predicate = ""
    if candidates:
        comparisons = [f"str(args->filename) == {bpftrace_string(item)}" for item in sorted(candidates)]
        predicate = "/" + " || ".join(comparisons) + "/"

    argv_exprs = ", ".join([f"str(args->argv[{idx}])" for idx in range(argv_slots)])
    env_exprs = ", ".join([f"str(args->envp[{idx}])" for idx in range(env_slots)])
    format_fields = ["%s"] * (argv_slots + env_slots)
    format_string = "RP_EXEC_ENTER\t%d\t%d\t%d\t%d\t%s\t%s\t" + "\t".join(format_fields) + "\n"
    values = ["pid", "ppid", "uid", "gid", "comm", "str(args->filename)", "str(args->argv[0])"]
    values.extend([f"str(args->argv[{idx}])" for idx in range(1, argv_slots)])
    values.extend([f"str(args->envp[{idx}])" for idx in range(env_slots)])
    # The first argv slot is included explicitly above to make the column layout stable.
    printf_values = ", ".join(values)

    return f"""
BEGIN
{{
  printf("RP_STARTUP_PROBE_READY\\n");
}}

tracepoint:syscalls:sys_enter_execve
{predicate}
{{
  printf({bpftrace_string(format_string)}, {printf_values});
}}

tracepoint:sched:sched_process_exit
{{
  printf("RP_PROC_EXIT\\t%d\\t%s\\n", args->pid, args->comm);
}}

interval:ms:{max(duration_ms, 100)}
{{
  exit();
}}
"""


@dataclass
class ExecObservation:
    pid: int
    ppid: int
    uid: int
    gid: int
    comm: str
    binary: str
    argv: list[str]
    env: dict[str, str]
    observed_at: str
    role: str
    sandbox_id: str
    cri_sandbox_id: str
    containerd_id: str
    runtime_type: str
    cni_plugin: str = ""
    cni_command: str = ""
    cni_netns: str = ""
    cni_netns_id: str = ""
    oci_runtime: str = ""
    oci_operation: str = ""
    oci_bundle: str = ""
    containerd_namespace: str = ""
    attributes: dict[str, object] = field(default_factory=dict)

    @property
    def request_id(self) -> str:
        key = self.cri_sandbox_id or self.containerd_id or self.sandbox_id or "unknown"
        return f"exec-{self.pid}-{sanitize_id(basename(self.binary))}-{sanitize_id(key)}"


@dataclass
class GoUprobeObservation:
    pid: int
    tid: int
    comm: str
    function: str
    symbol: str
    binary: str
    observed_at: str
    timestamp_ns: int = 0
    metadata: dict[str, str] = field(default_factory=dict)

    @property
    def request_id(self) -> str:
        return f"go-uprobe-{self.pid}-{self.tid}-{sanitize_id(self.function)}-{sanitize_id(self.symbol)}"


def parse_go_uprobe_line(line: str, metadata: dict[str, str] | None = None) -> tuple[str, GoUprobeObservation] | None:
    parts = line.rstrip("\n").split("\t")
    if len(parts) < 8 or parts[0] not in {"RP_GO_UPROBE_ENTER", "RP_GO_UPROBE_EXIT"}:
        return None
    try:
        timestamp_ns = int(parts[1])
        pid = int(parts[2])
        tid = int(parts[3])
    except ValueError:
        return None
    event_type = "enter" if parts[0].endswith("ENTER") else "exit"
    observed_at = timestamp_from_unix_nanos(timestamp_ns) if timestamp_ns > 0 else utc_now()
    return event_type, GoUprobeObservation(
        pid=pid,
        tid=tid,
        comm=parts[4],
        function=parts[5] or "RunPodSandbox",
        symbol=parts[6],
        binary=parts[7],
        observed_at=observed_at,
        timestamp_ns=timestamp_ns,
        metadata=dict(metadata or {}),
    )


def parse_go_uprobe_meta_line(line: str) -> tuple[tuple[int, int], str, str] | None:
    parts = line.rstrip("\n").split("\t", 8)
    if len(parts) < 9 or parts[0] != "RP_GO_UPROBE_META":
        return None
    try:
        pid = int(parts[2])
        tid = int(parts[3])
    except ValueError:
        return None
    field = parts[7].strip()
    value = parts[8].strip()
    if not field or not value:
        return None
    return (pid, tid), field, value


def metadata_stable_sandbox_id(metadata: dict[str, str]) -> str:
    namespace = metadata.get("k8s.namespace", "")
    pod = metadata.get("k8s.pod", "")
    return stable_kubernetes_sandbox_id(namespace, pod, "pod") if namespace and pod else ""


def add_top_level_identity_fields(event: dict[str, object], attributes: dict[str, object]) -> None:
    namespace = str(attributes.get("k8s.namespace") or attributes.get("cni.args.K8S_POD_NAMESPACE") or "").strip()
    pod = str(attributes.get("k8s.pod") or attributes.get("cni.args.K8S_POD_NAME") or "").strip()
    pod_uid = str(attributes.get("k8s.pod_uid") or attributes.get("cni.args.K8S_POD_UID") or "").strip()
    container = str(attributes.get("k8s.container") or "").strip()
    runtime_handler = str(attributes.get("cri.runtime_handler") or attributes.get("runtime.handler") or "").strip()
    if namespace:
        event["namespace"] = namespace
    if pod:
        event["podName"] = pod
    if pod_uid:
        event["podUid"] = pod_uid
    if container:
        event["containerName"] = container
    if runtime_handler:
        event["runtimeHandler"] = runtime_handler


def event_from_go_uprobe(obs: GoUprobeObservation, event_type: str, runtime_type: str, sandbox_id: str = "", cri_sandbox_id: str = "") -> dict[str, object]:
    role = go_uprobe_role(obs.function)
    phase = go_uprobe_startup_phase(role)
    attributes: dict[str, object] = {
        "startup.probe.backend": "bpftrace-go-uprobe",
        "startup.probe.correlation": "time-window" if sandbox_id or cri_sandbox_id else "pending-time-window",
        "startup.phase": phase,
        "startup.phase.source": "go-uprobe-function",
        "uprobe.symbol": obs.symbol,
        "uprobe.binary": obs.binary,
        "process.thread_id": obs.tid,
    }
    if role == "cni" and obs.function.startswith("CNISetup"):
        attributes["startup.probe.debug_boundary"] = True
        attributes["startup.probe.identity_source"] = "cni-exec-env-required"
    request_metadata = obs.metadata if obs.function == "RunPodSandbox" else {}
    for key, value in request_metadata.items():
        if value:
            attributes[key] = value
    stable_id = metadata_stable_sandbox_id(request_metadata)
    if stable_id:
        attributes["startup.stable_sandbox_id"] = stable_id
        attributes["startup.probe.req_identity"] = "runpod-request"
    if request_metadata.get("cri.runtime_handler"):
        attributes["cri.runtime_handler"] = request_metadata["cri.runtime_handler"]
    span_name = go_uprobe_span_name(obs.function)
    event = {
        "eventType": event_type,
        "requestId": obs.request_id,
        "function": obs.function,
        "timestamp": obs.observed_at,
        "timestampNs": obs.timestamp_ns,
        "sandboxId": sandbox_id,
        "criSandboxId": cri_sandbox_id or sandbox_id,
        "containerdId": cri_sandbox_id or sandbox_id,
        "runtimeType": runtime_type or "unknown",
        "status": "ok",
        "role": role,
        "binary": obs.binary,
        "command": basename(obs.binary) or "containerd",
        "pid": obs.pid,
        "ppid": 0,
        "attributes": attributes,
    }
    if span_name:
        event["spanName"] = span_name
    add_top_level_identity_fields(event, attributes)
    return event


def parse_env(items: Iterable[str]) -> dict[str, str]:
    env: dict[str, str] = {}
    for item in items:
        if not item or "=" not in item:
            continue
        key, value = item.split("=", 1)
        if key:
            env[key] = value
    return env


def parse_cni_args(value: str) -> dict[str, str]:
    parsed: dict[str, str] = {}
    for item in value.split(";"):
        if "=" not in item:
            continue
        key, val = item.split("=", 1)
        if key:
            parsed[key] = val
    return parsed


def stable_kubernetes_sandbox_id(namespace: str, pod: str, container: str = "pod") -> str:
    return f"k8s-{sanitize_id(namespace)}-{sanitize_id(pod)}-{sanitize_id(container or 'pod')}"


def oci_bundle_metadata(bundle: str) -> dict[str, str]:
    """Extract stable CRI/Kubernetes identity from an OCI bundle config.

    containerd writes CRI labels/annotations into the OCI runtime spec. Reading
    the bundle config lets runtime exec observations carry the same stable
    sandbox id as CRI/containerd event collectors, instead of only the raw
    containerd task id.
    """
    if not bundle:
        return {}
    config_path = Path(bundle) / "config.json"
    try:
        spec = json.loads(config_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return {}
    annotations = spec.get("annotations") or {}
    if not isinstance(annotations, dict):
        return {}
    labels = {str(key): str(value) for key, value in annotations.items() if value is not None}
    namespace = labels.get("io.kubernetes.pod.namespace", "")
    pod = labels.get("io.kubernetes.pod.name", "")
    container = labels.get("io.kubernetes.container.name", "")
    pod_uid = labels.get("io.kubernetes.pod.uid", "")
    runtime_handler = (
        labels.get("io.kubernetes.cri.runtime-handler", "")
        or labels.get("io.kubernetes.runtime.handler", "")
        or labels.get("io.kubernetes.cri-o.RuntimeHandler", "")
    )
    sandbox_container_id = (
        labels.get("io.kubernetes.cri.sandbox-id", "")
        or labels.get("io.kubernetes.sandbox.id", "")
        or labels.get("io.kubernetes.pod.sandbox.id", "")
        or labels.get("io.cri-containerd.sandbox-id", "")
    )
    phase = "sandbox" if container.lower() in {"", "pod"} else "container"
    stable_sandbox_id = stable_kubernetes_sandbox_id(namespace, pod, "pod") if namespace and pod else ""
    stable_container_id = ""
    if namespace and pod and phase == "container":
        stable_container_id = stable_kubernetes_sandbox_id(namespace, pod, container)
    metadata = {
        "k8s.namespace": namespace,
        "k8s.pod": pod,
        "k8s.container": container,
        "k8s.pod_uid": pod_uid,
        "cri.runtime_handler": runtime_handler,
        "cri.sandbox_container_id": sandbox_container_id,
        "startup.phase": phase,
        "startup.phase.source": "oci-bundle-config",
        "startup.stable_sandbox_id": stable_sandbox_id,
        "startup.stable_container_id": stable_container_id,
    }
    return {key: value for key, value in metadata.items() if value}


def fallback_containerd_bundle(namespace: str, container_id: str, argv: list[str]) -> str:
    if not namespace or not container_id:
        return ""
    candidates: list[str] = []
    for item in argv:
        if not item or "io.containerd.runtime" not in item:
            continue
        path = item
        # Shim start argv may include the runtime root only:
        #   .../io.containerd.runtime.v2.task/k8s.io
        parts = [part for part in Path(path).parts if part and part != os.sep]
        for idx, part in enumerate(parts):
            if part.startswith("io.containerd.runtime"):
                if idx + 1 < len(parts) and parts[idx + 1] == namespace:
                    if idx + 2 < len(parts):
                        candidates.append(containerd_task_bundle_from_path(path))
                    else:
                        candidates.append(os.path.join(os.sep, *parts[:idx + 2], container_id))
                break
    candidates.extend([
        f"/run/containerd/io.containerd.runtime.v2.task/{namespace}/{container_id}",
        f"/var/run/containerd/io.containerd.runtime.v2.task/{namespace}/{container_id}",
    ])
    for root in configured_containerd_task_roots():
        candidates.append(os.path.join(root, namespace, container_id))
    for candidate in candidates:
        if candidate and (Path(candidate) / "config.json").exists():
            return candidate
    return ""


def configured_containerd_task_roots() -> list[str]:
    roots: list[str] = []
    configs = [
        *EXTRA_CONTAINERD_CONFIGS,
        os.getenv("RUNTIMEPULSE_CONTAINERD_CONFIG", ""),
        "/etc/containerd/config.toml",
        "/tmp/runtimepulse-containerd-cri-test/config.toml",
    ]
    for config in unique_realpaths(configs):
        if not config:
            continue
        try:
            text = Path(config).read_text(encoding="utf-8")
        except OSError:
            continue
        for key in ("state", "root"):
            match = re.search(rf"(?m)^\s*{key}\s*=\s*['\"]([^'\"]+)['\"]", text)
            if not match:
                continue
            roots.append(os.path.join(match.group(1), "io.containerd.runtime.v2.task"))
    return unique_realpaths(roots)


def netns_identity(path: str) -> dict[str, object]:
    """Return a stable-ish netns identity for CNI correlation.

    CNI passes the target sandbox netns as a path.  The path may be transient
    or reused, so capture the nsfs device/inode when the exec event is parsed
    and use that as the primary association key.
    """
    clean = path.strip()
    if not clean:
        return {}
    attrs: dict[str, object] = {"cni.netns.path": clean}
    try:
        stat = os.stat(clean)
    except OSError as exc:
        attrs["cni.netns.stat_error"] = exc.strerror or exc.__class__.__name__
        return attrs
    attrs["cni.netns.dev"] = stat.st_dev
    attrs["cni.netns.ino"] = stat.st_ino
    attrs["cni.netns.id"] = f"netns:{stat.st_dev}:{stat.st_ino}"
    return attrs


def exec_startup_phase(role: str) -> str:
    if role == "cni":
        return "sandbox-network"
    if role == "helper":
        return "helper"
    if role in {"oci", "kata"}:
        # A runtime/shim process is a containerd task boundary.  It can be the
        # sandbox task during RunPodSandbox, or a later workload-container task;
        # keep the exact containerd id so higher layers can distinguish them.
        return "containerd-task"
    return "process"


def go_uprobe_startup_phase(role: str) -> str:
    if role == "cri":
        return "sandbox-cri"
    if role == "cni":
        return "sandbox-network"
    if role in {"oci", "kata"}:
        return "containerd-task"
    return "process"


def parse_exec_line(line: str, argv_slots: int, env_slots: int, observed_at: str, default_runtime_type: str, forced_sandbox_id: str) -> ExecObservation | None:
    parts = line.rstrip("\n").split("\t")
    expected = 6 + argv_slots + env_slots
    if len(parts) < expected or parts[0] != "RP_EXEC_ENTER":
        return None
    try:
        pid = int(parts[1])
        ppid = int(parts[2])
        uid = int(parts[3])
        gid = int(parts[4])
    except ValueError:
        return None
    comm = parts[5]
    binary = parts[6]
    argv_start = 7
    argv = [item for item in parts[argv_start:argv_start + argv_slots] if item]
    env_items = parts[argv_start + argv_slots:argv_start + argv_slots + env_slots]
    env = parse_env(env_items)
    cni_args = parse_cni_args(env.get("CNI_ARGS", ""))

    role = infer_role(binary, argv, env)
    cni_container_id = env.get("CNI_CONTAINERID", "") or cni_args.get("K8S_POD_INFRA_CONTAINER_ID", "")
    bundle = infer_oci_bundle(argv)
    shim_info = infer_containerd_shim_info(argv)
    namespace = namespace_from_bundle(bundle)
    namespace = namespace or shim_info.get("namespace", "")
    containerd_id = cni_container_id or sandbox_id_from_bundle(bundle) or shim_info.get("id", "")
    if not bundle:
        bundle = shim_info.get("bundle", "") or fallback_containerd_bundle(namespace, containerd_id, argv)
    bundle_meta = oci_bundle_metadata(bundle)
    stable_bundle_id = bundle_meta.get("startup.stable_sandbox_id", "")
    sandbox_id = forced_sandbox_id or stable_bundle_id or containerd_id
    runtime_type = infer_runtime_type(binary, argv, default_runtime_type)
    oci_runtime = basename(binary) if role in {"oci", "kata"} and basename(binary).startswith("containerd-shim-") else (basename(binary) if role == "oci" else "")
    oci_operation = infer_oci_operation(argv) if role in {"oci", "kata"} else ""
    cni_plugin = basename(binary) if role == "cni" else ""
    cni_netns = env.get("CNI_NETNS", "")
    netns_attrs = netns_identity(cni_netns)
    cni_netns_id = str(netns_attrs.get("cni.netns.id", "") or "")

    attributes: dict[str, object] = {
        "startup.probe.backend": "bpftrace-execve",
        "startup.phase": exec_startup_phase(role),
        "startup.phase.source": "exec-role",
        "process.uid": uid,
        "process.gid": gid,
    }
    if containerd_id:
        attributes["containerd.container_id"] = containerd_id
    attributes.update(bundle_meta)
    if stable_bundle_id and containerd_id and stable_bundle_id != containerd_id:
        attributes["containerd.raw_id"] = containerd_id
        attributes["startup.probe.correlation"] = "oci-bundle-config"
        attributes["startup.probe.correlation_sandbox_id"] = stable_bundle_id
    if role in {"oci", "kata"} and containerd_id:
        if "startup.probe.correlation" not in attributes:
            if bundle_meta:
                correlation = "oci-bundle-config"
            elif bundle:
                correlation = "oci-bundle-path"
            elif shim_info.get("id"):
                correlation = "containerd-shim-argv"
            else:
                correlation = "containerd-task-id"
            attributes["startup.probe.correlation"] = correlation
            attributes["startup.probe.correlation_sandbox_id"] = sandbox_id or containerd_id
    if bundle_meta.get("cri.sandbox_container_id"):
        attributes["containerd.sandbox_container_id"] = bundle_meta["cri.sandbox_container_id"]
    if cni_container_id:
        attributes["cni.container_id"] = cni_container_id
    attributes.update(netns_attrs)
    if bundle:
        attributes["oci.bundle"] = bundle
    if namespace:
        attributes["containerd.namespace"] = namespace
    if shim_info.get("bundle"):
        attributes["containerd.bundle"] = shim_info["bundle"]
    if env.get("CNI_IFNAME"):
        attributes["cni.ifname"] = env["CNI_IFNAME"]
    if env.get("CNI_PATH"):
        attributes["cni.path"] = env["CNI_PATH"]
    for key in ("K8S_POD_INFRA_CONTAINER_ID", "K8S_POD_NAMESPACE", "K8S_POD_NAME", "K8S_POD_UID"):
        if cni_args.get(key):
            attributes[f"cni.args.{key}"] = cni_args[key]

    return ExecObservation(
        pid=pid,
        ppid=ppid,
        uid=uid,
        gid=gid,
        comm=comm,
        binary=binary,
        argv=argv,
        env={key: env[key] for key in CNI_ENV_KEYS if key in env},
        observed_at=observed_at,
        role=role,
        sandbox_id=sandbox_id,
        cri_sandbox_id=cni_container_id or stable_bundle_id or containerd_id,
        containerd_id=containerd_id,
        runtime_type=runtime_type,
        cni_plugin=cni_plugin,
        cni_command=env.get("CNI_COMMAND", ""),
        cni_netns=cni_netns,
        cni_netns_id=cni_netns_id,
        oci_runtime=oci_runtime,
        oci_operation=oci_operation,
        oci_bundle=bundle,
        containerd_namespace=namespace,
        attributes=attributes,
    )


def infer_role(binary: str, argv: list[str], env: dict[str, str]) -> str:
    base = basename(binary).lower()
    if is_helper_binary(base):
        return "helper"
    if env.get("CNI_COMMAND") or env.get("CNI_CONTAINERID") or is_likely_cni_binary(base):
        return "cni"
    if base in {"runc", "crun", "kata-runtime", "runsc"}:
        return "oci"
    if "kata" in base or base.startswith("qemu-system") or base in {"cloud-hypervisor", "firecracker", "virtiofsd"}:
        return "kata"
    if base.startswith("containerd-shim-"):
        return "oci"
    return "exec"


def is_likely_cni_binary(base: str) -> bool:
    return base in {
        "bridge", "loopback", "portmap", "firewall", "host-local", "bandwidth", "tuning",
        "calico", "calico-ipam", "cilium-cni", "multus", "flannel", "weave-net",
    }


def is_helper_binary(base: str) -> bool:
    return base in {
        "iptables", "iptables-restore", "ip6tables", "ip6tables-restore", "nft",
        "ip", "ipset", "tc", "mount", "umount", "modprobe",
    }


def infer_runtime_type(binary: str, argv: list[str], default: str) -> str:
    text = " ".join([binary, *argv]).lower()
    if "kata" in text:
        return "kata"
    if "runsc" in text or "gvisor" in text:
        return "gvisor"
    if "firecracker" in text:
        return "firecracker"
    if basename(binary).lower() in {"runc", "crun"}:
        return "runc"
    return default or "unknown"


def infer_oci_operation(argv: list[str]) -> str:
    if argv and basename(argv[0]).startswith("containerd-shim-"):
        return "shim.start"
    for item in argv[1:]:
        value = item.strip().lower()
        if value in OCI_OPS:
            return value
    return ""


def infer_containerd_shim_info(argv: list[str]) -> dict[str, str]:
    info: dict[str, str] = {}
    for idx, item in enumerate(argv):
        if item == "-namespace" and idx + 1 < len(argv):
            info["namespace"] = argv[idx + 1]
        elif item.startswith("-namespace="):
            info["namespace"] = item.split("=", 1)[1]
        elif item == "-id" and idx + 1 < len(argv):
            info["id"] = argv[idx + 1]
        elif item.startswith("-id="):
            info["id"] = item.split("=", 1)[1]
        elif item == "-bundle" and idx + 1 < len(argv):
            info["bundle"] = argv[idx + 1]
        elif item.startswith("-bundle="):
            info["bundle"] = item.split("=", 1)[1]
    return info


def infer_oci_bundle(argv: list[str]) -> str:
    for idx, item in enumerate(argv):
        if item in {"--bundle", "-b"} and idx + 1 < len(argv):
            return argv[idx + 1]
        if item.startswith("--bundle="):
            return item.split("=", 1)[1]
    for item in argv:
        if "/io.containerd.runtime" in item or "/run/containerd/" in item:
            bundle = containerd_task_bundle_from_path(item)
            if bundle:
                return bundle
    return ""


def containerd_task_bundle_from_path(path: str) -> str:
    parts = [part for part in Path(path).parts if part and part != os.sep]
    for idx, part in enumerate(parts):
        if part.startswith("io.containerd.runtime") and idx + 2 < len(parts):
            prefix = [os.sep, *parts[:idx + 3]]
            return os.path.join(*prefix)
    return ""


def sandbox_id_from_bundle(bundle: str) -> str:
    if not bundle:
        return ""
    parts = [part for part in Path(bundle).parts if part and part != os.sep]
    # Common path: .../io.containerd.runtime.v2.task/k8s.io/<container-id>
    for idx, part in enumerate(parts):
        if part.startswith("io.containerd.runtime") and idx + 2 < len(parts):
            return parts[idx + 2]
    return ""


def namespace_from_bundle(bundle: str) -> str:
    if not bundle:
        return ""
    parts = [part for part in Path(bundle).parts if part and part != os.sep]
    for idx, part in enumerate(parts):
        if part.startswith("io.containerd.runtime") and idx + 1 < len(parts):
            return parts[idx + 1]
    return ""


def event_from_observation(obs: ExecObservation, event_type: str, timestamp: str, status: str = "ok") -> dict[str, object]:
    event: dict[str, object] = {
        "eventType": event_type,
        "requestId": obs.request_id,
        "function": "execve",
        "timestamp": timestamp,
        "sandboxId": obs.sandbox_id,
        "criSandboxId": obs.cri_sandbox_id,
        "containerdId": obs.containerd_id,
        "runtimeType": obs.runtime_type,
        "status": status,
        "role": obs.role,
        "binary": obs.binary,
        "command": obs.argv[0] if obs.argv else basename(obs.binary),
        "pid": obs.pid,
        "ppid": obs.ppid,
        "argv": obs.argv,
        "attributes": dict(obs.attributes),
    }
    if obs.env:
        event["env"] = obs.env
    if obs.cni_plugin:
        event["cniPlugin"] = obs.cni_plugin
    if obs.cni_command:
        event["cniCommand"] = obs.cni_command
    if obs.cri_sandbox_id and obs.role == "cni":
        event["cniContainerId"] = obs.cri_sandbox_id
    if obs.cni_netns:
        event["cniNetns"] = obs.cni_netns
    if obs.cni_netns_id:
        event["cniNetnsId"] = obs.cni_netns_id
    if obs.oci_runtime:
        event["ociRuntime"] = obs.oci_runtime
    if obs.oci_operation:
        event["ociOperation"] = obs.oci_operation
    if obs.oci_bundle:
        event["ociBundle"] = obs.oci_bundle
    if obs.containerd_namespace:
        event.setdefault("attributes", {})["containerd.namespace"] = obs.containerd_namespace
    add_top_level_identity_fields(event, event.get("attributes") or {})
    return event


def collect_from_stream(lines: Iterable[str], argv_slots: int, env_slots: int, default_runtime_type: str, forced_sandbox_id: str, namespaces: set[str] | None = None) -> tuple[list[dict[str, object]], dict[str, float], str, str, str]:
    pending: dict[int, ExecObservation] = {}
    pending_go: dict[str, GoUprobeObservation] = {}
    go_meta_by_thread: dict[tuple[int, int], dict[str, str]] = {}
    events: list[dict[str, object]] = []
    runtime_type = default_runtime_type or "unknown"
    sandbox_id = forced_sandbox_id
    cri_sandbox_id = ""
    containerd_id = ""

    for raw in lines:
        now = utc_now()
        if raw.startswith("RP_GO_UPROBE_META\t"):
            parsed_meta = parse_go_uprobe_meta_line(raw)
            if parsed_meta:
                thread_key, field, value = parsed_meta
                go_meta_by_thread.setdefault(thread_key, {})[field] = value
            continue
        if raw.startswith("RP_GO_UPROBE_ENTER\t") or raw.startswith("RP_GO_UPROBE_EXIT\t"):
            parsed_peek = raw.rstrip("\n").split("\t")
            meta_key = None
            if len(parsed_peek) >= 4:
                try:
                    meta_key = (int(parsed_peek[2]), int(parsed_peek[3]))
                except ValueError:
                    meta_key = None
            parsed_go = parse_go_uprobe_line(raw, go_meta_by_thread.get(meta_key or (-1, -1), {}))
            if not parsed_go:
                continue
            event_type, obs = parsed_go
            if event_type == "enter":
                pending_go[obs.request_id] = obs
            else:
                pending_go.pop(obs.request_id, None)
            events.append(event_from_go_uprobe(obs, event_type, runtime_type, "", ""))
        elif raw.startswith("RP_EXEC_ENTER\t"):
            obs = parse_exec_line(raw, argv_slots, env_slots, now, default_runtime_type, forced_sandbox_id)
            if not obs:
                continue
            if obs.role != "helper" and not observation_matches_namespace(obs, namespaces):
                continue
            if obs.role == "helper" and not observation_matches_namespace(obs, namespaces):
                parent = pending.get(obs.ppid)
                if parent and (not namespaces or observation_matches_namespace(parent, namespaces)):
                    inherit_parent_context(obs, parent)
                else:
                    continue
            pending[obs.pid] = obs
            runtime_type = choose_runtime_type(runtime_type, obs.runtime_type)
            sandbox_id = sandbox_id or obs.sandbox_id
            cri_sandbox_id = cri_sandbox_id or obs.cri_sandbox_id
            containerd_id = containerd_id or obs.containerd_id
            events.append(event_from_observation(obs, "enter", obs.observed_at))
        elif raw.startswith("RP_PROC_EXIT\t"):
            parts = raw.rstrip("\n").split("\t")
            if len(parts) < 2:
                continue
            try:
                pid = int(parts[1])
            except ValueError:
                continue
            obs = pending.pop(pid, None)
            if obs:
                events.append(event_from_observation(obs, "exit", now))

    # If a short capture window ends before process exit, emit complete events with a
    # minimal duration so the startup-callchain normalizer still surfaces the binary.
    for obs in pending.values():
        exit_time = utc_now()
        event = event_from_observation(obs, "exit", exit_time)
        event["durationMs"] = 1
        event.setdefault("attributes", {})["startup.probe.exitMissing"] = True
        events.append(event)
    synthetic_exit_time = max([str(event.get("timestamp", "") or "") for event in events] or [utc_now()]) or utc_now()
    for obs in pending_go.values():
        event = event_from_go_uprobe(obs, "exit", runtime_type, "", "")
        event["timestamp"] = synthetic_exit_time
        event["durationMs"] = 1
        event.setdefault("attributes", {})["startup.probe.exitMissing"] = True
        event.setdefault("attributes", {})["startup.probe.exitSynthetic"] = "last-observed-startup-event"
        events.append(event)

    events = correlate_cni_netns_events(events)
    events = correlate_oci_bundle_metadata_events(events)
    events = correlate_containerd_go_uprobes_by_cni_identity(events)
    events = correlate_go_uprobe_events(events)
    events = propagate_sandbox_identity_fields(events)
    sandbox_id = first_event_value(events, "sandboxId", "criSandboxId", "containerdId") or sandbox_id
    cri_sandbox_id = first_event_value(events, "criSandboxId", "sandboxId", "containerdId") or cri_sandbox_id
    summary = summarize_events(events)
    return events, summary, runtime_type, sandbox_id, cri_sandbox_id or containerd_id


def event_time(event: dict[str, object]) -> datetime | None:
    return parse_iso8601(str(event.get("timestamp", "") or ""))


def event_time_range(events: list[dict[str, object]]) -> tuple[datetime | None, datetime | None]:
    times = [event_time(event) for event in events]
    times = [time for time in times if time is not None]
    if not times:
        return None, None
    return min(times), max(times)


def report_time_window_for_events(events: list[dict[str, object]]) -> tuple[str, str, float] | None:
    start, end = event_time_range(events)
    if not start or not end:
        return None
    duration_ms = max(1.0, (end - start).total_seconds() * 1000.0)
    return (
        start.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
        end.isoformat(timespec="milliseconds").replace("+00:00", "Z"),
        duration_ms,
    )


def is_window_correlated_go_uprobe(event: dict[str, object]) -> bool:
    attrs = event.get("attributes") or {}
    return isinstance(attrs, dict) and attrs.get("startup.probe.backend") == "bpftrace-go-uprobe"


def is_pending_window_go_uprobe(event: dict[str, object]) -> bool:
    attrs = event.get("attributes") or {}
    return (
        isinstance(attrs, dict)
        and attrs.get("startup.probe.backend") == "bpftrace-go-uprobe"
        and attrs.get("startup.probe.correlation") == "pending-time-window"
    )


def int_event_value(event: dict[str, object], key: str) -> int | None:
    value = event.get(key)
    if value is None or value == "":
        return None
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def event_attribute(event: dict[str, object], key: str) -> object:
    attrs = event.get("attributes") or {}
    if isinstance(attrs, dict):
        return attrs.get(key, "")
    return ""


def event_runtime_identity(event: dict[str, object]) -> str:
    for key in ("containerdId", "criSandboxId", "sandboxId"):
        value = str(event.get(key, "") or "").strip()
        if value:
            return value
    for key in ("containerd.container_id", "containerd.raw_id", "cri.sandbox_container_id"):
        value = str(event_attribute(event, key) or "").strip()
        if value:
            return value
    return ""


def event_netns_key(event: dict[str, object]) -> str:
    for key in ("cniNetnsId", "cni_netns_id", "netnsId"):
        value = str(event.get(key, "") or "").strip()
        if value:
            return value
    value = str(event_attribute(event, "cni.netns.id") or "").strip()
    return value


def assign_event_to_sandbox(
    event: dict[str, object],
    key: str,
    cri_id: str,
    containerd_id: str,
    runtime_type: str,
    correlation: str,
) -> dict[str, object]:
    updated = dict(event)
    updated["sandboxId"] = key
    updated["criSandboxId"] = cri_id or key
    updated["containerdId"] = containerd_id or cri_id or key
    updated["runtimeType"] = runtime_type or str(event.get("runtimeType") or "unknown")
    attrs = dict(updated.get("attributes") or {})
    attrs["startup.probe.correlation"] = correlation
    attrs["startup.probe.correlation_sandbox_id"] = key
    updated["attributes"] = attrs
    return updated



def cni_event_identity(event: dict[str, object]) -> dict[str, str]:
    if str(event.get("role") or "").lower() != "cni":
        return {}
    attrs = event.get("attributes") or {}
    attrs = attrs if isinstance(attrs, dict) else {}
    env = event.get("env") or {}
    env = env if isinstance(env, dict) else {}
    cni_args = parse_cni_args(str(env.get("CNI_ARGS") or ""))
    sandbox_id = (
        str(event.get("sandboxId") or "").strip()
        or str(event.get("criSandboxId") or "").strip()
        or str(attrs.get("cni.container_id") or "").strip()
        or str(env.get("CNI_CONTAINERID") or "").strip()
        or str(cni_args.get("K8S_POD_INFRA_CONTAINER_ID") or "").strip()
    )
    if not sandbox_id:
        return {}
    raw_cri_id = str(event.get("criSandboxId") or sandbox_id)
    raw_containerd_id = str(event.get("containerdId") or sandbox_id)
    identity = {
        "sandboxId": sandbox_id,
        "criSandboxId": raw_cri_id,
        "containerdId": raw_containerd_id,
        "runtimeType": str(event.get("runtimeType") or "unknown"),
    }
    for arg_key, out_key in (
        ("K8S_POD_NAMESPACE", "k8s.namespace"),
        ("K8S_POD_NAME", "k8s.pod"),
        ("K8S_POD_UID", "k8s.pod_uid"),
        ("K8S_POD_INFRA_CONTAINER_ID", "cni.args.K8S_POD_INFRA_CONTAINER_ID"),
    ):
        value = str(attrs.get(f"cni.args.{arg_key}") or cni_args.get(arg_key) or "").strip()
        if value:
            identity[out_key] = value
    stable_id = stable_kubernetes_sandbox_id(identity.get("k8s.namespace", ""), identity.get("k8s.pod", ""), "pod") if identity.get("k8s.namespace") and identity.get("k8s.pod") else ""
    if stable_id:
        identity["startup.stable_sandbox_id"] = stable_id
    if str(attrs.get("cni.container_id") or "").strip():
        identity["cni.container_id"] = str(attrs.get("cni.container_id"))
    elif str(env.get("CNI_CONTAINERID") or "").strip():
        identity["cni.container_id"] = str(env.get("CNI_CONTAINERID"))
    return identity


def correlate_containerd_go_uprobes_by_cni_identity(events: list[dict[str, object]]) -> list[dict[str, object]]:
    """Annotate pending containerd CRI/CNI uprobes from CNI env identity.

    CNI plugin execs carry stable CRI identity via CNI_CONTAINERID and
    CNI_ARGS.K8S_POD_INFRA_CONTAINER_ID.  Under concurrent RunPodSandbox calls,
    bare containerd Go uprobes only have pid/tid/function.  This pass only
    assigns them to a sandbox when a CNI identity is the single plausible match
    for the event timestamp, avoiding ambiguous time-window attribution.
    """
    identities: list[tuple[datetime, dict[str, str]]] = []
    seen: set[tuple[str, str]] = set()
    for event in events:
        identity = cni_event_identity(event)
        if not identity:
            continue
        ts = event_time(event)
        if not ts:
            continue
        key = (identity.get("sandboxId", ""), identity.get("cni.container_id", ""))
        if key in seen:
            continue
        seen.add(key)
        identities.append((ts, identity))
    if not identities:
        return events

    result: list[dict[str, object]] = []
    for event in events:
        if not is_pending_window_go_uprobe(event) or event_sandbox_key(event) != "unknown":
            result.append(event)
            continue
        role = str(event.get("role") or "").lower()
        if role not in {"cri", "cni"}:
            result.append(event)
            continue
        attrs = event.get("attributes") or {}
        attrs = attrs if isinstance(attrs, dict) else {}
        if role == "cri" and attrs.get("startup.probe.req_identity") == "runpod-request":
            stable_id = str(attrs.get("startup.stable_sandbox_id") or "").strip()
            k8s_namespace = str(attrs.get("k8s.namespace") or "").strip()
            k8s_pod = str(attrs.get("k8s.pod") or "").strip()
            k8s_uid = str(attrs.get("k8s.pod_uid") or "").strip()
            request_matches = []
            for _cni_ts, identity in identities:
                if stable_id and identity.get("startup.stable_sandbox_id") == stable_id:
                    request_matches.append(identity)
                    continue
                if (
                    k8s_namespace
                    and k8s_pod
                    and identity.get("k8s.namespace") == k8s_namespace
                    and identity.get("k8s.pod") == k8s_pod
                    and (not k8s_uid or identity.get("k8s.pod_uid") == k8s_uid)
                ):
                    request_matches.append(identity)
            raw_sandbox_ids = {match.get("sandboxId", "") for match in request_matches}
            raw_sandbox_ids.discard("")
            if len(raw_sandbox_ids) == 1:
                identity = request_matches[0]
                assigned = assign_event_to_sandbox(
                    event,
                    identity["sandboxId"],
                    identity.get("criSandboxId", identity["sandboxId"]),
                    identity.get("containerdId", identity.get("criSandboxId", identity["sandboxId"])),
                    identity.get("runtimeType", str(event.get("runtimeType") or "unknown")),
                    "runpod-request-cni-env",
                )
                assigned_attrs = dict(assigned.get("attributes") or {})
                for key in ("k8s.namespace", "k8s.pod", "k8s.pod_uid", "startup.stable_sandbox_id", "cri.runtime_handler", "cni.container_id", "cni.args.K8S_POD_INFRA_CONTAINER_ID"):
                    if attrs.get(key):
                        assigned_attrs.setdefault(key, attrs[key])
                    if identity.get(key):
                        assigned_attrs.setdefault(key, identity[key])
                assigned_attrs["startup.probe.req_identity"] = "runpod-request"
                assigned_attrs["startup.probe.correlation_detail"] = "runpod-request-matched-cni-args"
                assigned["attributes"] = assigned_attrs
                result.append(assigned)
                continue
        ts = event_time(event)
        if not ts:
            result.append(event)
            continue
        # RunPodSandbox starts before CNI ADD; CNISetup can be just before or
        # during plugin execution.  Keep a narrow forward window so two
        # concurrent pod starts only assign when one CNI identity is plausible.
        max_before = timedelta(seconds=15 if role == "cri" else 5)
        max_after = timedelta(seconds=1)
        candidates: list[tuple[float, dict[str, str]]] = []
        for cni_ts, identity in identities:
            delta = (cni_ts - ts).total_seconds()
            if -max_after.total_seconds() <= delta <= max_before.total_seconds():
                candidates.append((abs(delta), identity))
        sandbox_ids = {candidate[1].get("sandboxId", "") for candidate in candidates}
        sandbox_ids.discard("")
        if len(sandbox_ids) != 1:
            result.append(event)
            continue
        _distance, identity = sorted(candidates, key=lambda item: item[0])[0]
        assigned = assign_event_to_sandbox(
            event,
            identity["sandboxId"],
            identity.get("criSandboxId", identity["sandboxId"]),
            identity.get("containerdId", identity.get("criSandboxId", identity["sandboxId"])),
            identity.get("runtimeType", str(event.get("runtimeType") or "unknown")),
            "cni-env",
        )
        attrs = dict(assigned.get("attributes") or {})
        for key in ("k8s.namespace", "k8s.pod", "k8s.pod_uid", "startup.stable_sandbox_id", "cni.container_id", "cni.args.K8S_POD_INFRA_CONTAINER_ID"):
            if identity.get(key):
                attrs.setdefault(key, identity[key])
        attrs["startup.probe.correlation_detail"] = "cni-containerid-single-candidate"
        assigned["attributes"] = attrs
        result.append(assigned)
    return result

def correlate_cni_netns_events(events: list[dict[str, object]]) -> list[dict[str, object]]:
    """Join CNI/helper execs by netns inode before falling back to id/window joins.

    The CNI target netns is the stable sandbox-network anchor.  This pass lets
    helpers or plugins that miss CNI_CONTAINERID still join the sandbox when
    another CNI event in the same capture has the same nsfs device/inode.
    """
    netns_to_identity: dict[str, tuple[str, str, str, str]] = {}
    for event in events:
        netns = event_netns_key(event)
        sandbox = event_sandbox_key(event)
        if not netns or sandbox == "unknown":
            continue
        cri_id = str(event.get("criSandboxId", "") or "").strip()
        containerd_id = str(event.get("containerdId", "") or "").strip()
        runtime_type = str(event.get("runtimeType", "") or "").strip()
        netns_to_identity.setdefault(netns, (sandbox, cri_id, containerd_id, runtime_type))
    if not netns_to_identity:
        return events

    result: list[dict[str, object]] = []
    for event in events:
        if event_sandbox_key(event) != "unknown":
            result.append(event)
            continue
        role = str(event.get("role") or "").lower()
        if role not in {"cni", "helper"}:
            result.append(event)
            continue
        netns = event_netns_key(event)
        identity = netns_to_identity.get(netns)
        if not identity:
            result.append(event)
            continue
        sandbox, cri_id, containerd_id, runtime_type = identity
        result.append(assign_event_to_sandbox(event, sandbox, cri_id, containerd_id, runtime_type, "netns"))
    return result


def correlate_oci_bundle_metadata_events(events: list[dict[str, object]]) -> list[dict[str, object]]:
    """Propagate OCI bundle metadata to shim/uprobe events with the same task id.

    runc execs often include --bundle and can read config.json. Shim execs and
    shim Go uprobes usually only carry the containerd task id/PID.  This pass
    copies the stable CRI/K8s identity from bundle-aware runtime exec events to
    those task-level events before PID uprobe correlation runs.
    """
    identity_by_raw_id: dict[str, dict[str, object]] = {}
    for event in events:
        attrs = event.get("attributes") or {}
        if not isinstance(attrs, dict):
            continue
        raw_id = str(attrs.get("containerd.raw_id") or event.get("containerdId") or "").strip()
        stable_id = str(attrs.get("startup.stable_sandbox_id") or event.get("sandboxId") or "").strip()
        if not raw_id or not stable_id or raw_id == stable_id:
            continue
        identity_by_raw_id.setdefault(raw_id, {
            "sandboxId": stable_id,
            "criSandboxId": str(event.get("criSandboxId") or stable_id),
            "runtimeType": str(event.get("runtimeType") or "unknown"),
            "attributes": {
                key: value
                for key, value in attrs.items()
                if key.startswith("k8s.")
                or key.startswith("cri.")
                or key in {
                    "containerd.raw_id",
                    "containerd.sandbox_container_id",
                    "startup.phase",
                    "startup.phase.source",
                    "startup.stable_sandbox_id",
                    "startup.stable_container_id",
                }
            },
        })
    if not identity_by_raw_id:
        return events

    result: list[dict[str, object]] = []
    for event in events:
        raw_id = event_runtime_identity(event)
        identity = identity_by_raw_id.get(raw_id)
        if not identity:
            result.append(event)
            continue
        updated = dict(event)
        updated["sandboxId"] = identity["sandboxId"]
        updated["criSandboxId"] = identity["criSandboxId"]
        # Keep containerdId as the raw task/container id for runtime debugging.
        updated["containerdId"] = raw_id
        updated["runtimeType"] = identity["runtimeType"] or str(event.get("runtimeType") or "unknown")
        attrs = dict(updated.get("attributes") or {})
        for key, value in identity["attributes"].items():
            attrs.setdefault(key, value)
        attrs["startup.probe.correlation"] = "oci-bundle-config"
        attrs["startup.probe.correlation_sandbox_id"] = identity["sandboxId"]
        updated["attributes"] = attrs
        result.append(updated)
    return result


def assign_go_uprobe_to_sandbox(
    event: dict[str, object],
    key: str,
    cri_id: str,
    runtime_type: str,
    correlation: str,
) -> dict[str, object]:
    return assign_event_to_sandbox(event, key, cri_id, cri_id or key, runtime_type, correlation)


def runtime_boundary_go_uprobe(event: dict[str, object]) -> bool:
    return str(event.get("role") or "").lower() in {"oci", "kata"}


def correlate_go_uprobe_events(events: list[dict[str, object]]) -> list[dict[str, object]]:
    sandbox_events = [event for event in events if not is_pending_window_go_uprobe(event) and event_sandbox_key(event) != "unknown"]
    if not sandbox_events:
        return events
    windows: dict[str, tuple[datetime, datetime, str]] = {}
    runtime_by_key: dict[str, str] = {}
    pid_to_key: dict[int, str] = {}
    pid_to_cri_id: dict[int, str] = {}
    pid_to_runtime: dict[int, str] = {}
    pid_to_containerd_id: dict[int, str] = {}
    pid_to_phase: dict[int, str] = {}
    pid_to_attributes: dict[int, dict[str, object]] = {}
    for key in sorted({event_sandbox_key(event) for event in sandbox_events}):
        group = [event for event in sandbox_events if event_sandbox_key(event) == key]
        start, end = event_time_range(group)
        if not start or not end:
            continue
        cri_id = first_event_value(group, "criSandboxId", "sandboxId", "containerdId")
        runtime = runtime_type_from_events(group, "unknown")
        windows[key] = (start - timedelta(seconds=2), end + timedelta(seconds=2), cri_id)
        runtime_by_key[key] = runtime
        for item in group:
            pid = int_event_value(item, "pid")
            if pid is None:
                continue
            pid_to_key.setdefault(pid, key)
            pid_to_cri_id.setdefault(pid, cri_id)
            pid_to_runtime.setdefault(pid, runtime)
            pid_to_containerd_id.setdefault(pid, str(item.get("containerdId", "") or ""))
            pid_to_phase.setdefault(pid, str(event_attribute(item, "startup.phase") or ""))
            attrs = item.get("attributes") or {}
            if isinstance(attrs, dict):
                pid_to_attributes.setdefault(pid, dict(attrs))
    if not windows:
        return events
    result: list[dict[str, object]] = []
    for event in events:
        if not is_pending_window_go_uprobe(event) or event_sandbox_key(event) != "unknown":
            result.append(event)
            continue

        # Runtime shim Go uprobes execute in the shim process. Prefer exact PID
        # correlation to the observed shim exec event and intentionally drop
        # unmatched runtime-boundary uprobes instead of time-window joining them;
        # otherwise unrelated host/container runtime activity inside the capture
        # window can be attributed to the RunPodSandbox under test.
        pid = int_event_value(event, "pid")
        if runtime_boundary_go_uprobe(event):
            if pid is not None and pid in pid_to_key:
                key = pid_to_key[pid]
                assigned = assign_event_to_sandbox(
                    event,
                    key,
                    pid_to_cri_id.get(pid, key),
                    pid_to_containerd_id.get(pid, pid_to_cri_id.get(pid, key)),
                    pid_to_runtime.get(pid, runtime_by_key.get(key, "unknown")),
                    "pid",
                )
                attrs = dict(assigned.get("attributes") or {})
                for attr_key, attr_value in pid_to_attributes.get(pid, {}).items():
                    if attr_key.startswith("k8s.") or attr_key.startswith("cri.") or attr_key in {
                        "containerd.raw_id",
                        "containerd.sandbox_container_id",
                        "oci.bundle",
                        "startup.stable_sandbox_id",
                    }:
                        attrs.setdefault(attr_key, attr_value)
                if pid_to_phase.get(pid):
                    attrs["startup.phase"] = pid_to_phase[pid]
                    attrs["startup.phase.source"] = "matched-shim-pid"
                if pid_to_containerd_id.get(pid):
                    attrs["containerd.container_id"] = pid_to_containerd_id[pid]
                assigned["attributes"] = attrs
                result.append(assigned)
            continue

        if str(event.get("role") or "").lower() == "cni" and len(windows) > 1:
            # Containerd CNI setup uprobes often run on worker threads that do
            # not expose the RunPod request pointer. In concurrent captures,
            # broad report time windows overlap, so assigning these by timestamp
            # can split enter/exit across different sandboxes. Keep them pending
            # unless an earlier exact request/CNI identity pass has assigned them.
            result.append(event)
            continue

        ts = event_time(event)
        candidates: list[tuple[float, str]] = []
        if ts:
            for key, (start, end, _cri_id) in windows.items():
                if start <= ts <= end:
                    center = start + (end - start) / 2
                    candidates.append((abs((ts - center).total_seconds()), key))
        if not candidates and len(windows) == 1:
            candidates = [(0.0, next(iter(windows)))]
        if not candidates:
            result.append(event)
            continue
        _distance, key = sorted(candidates)[0]
        _start, _end, cri_id = windows[key]
        result.append(assign_go_uprobe_to_sandbox(event, key, cri_id, runtime_by_key.get(key, "unknown"), "time-window"))
    return result

def inherit_parent_context(obs: ExecObservation, parent: ExecObservation) -> None:
    obs.sandbox_id = obs.sandbox_id or parent.sandbox_id
    obs.cri_sandbox_id = obs.cri_sandbox_id or parent.cri_sandbox_id
    obs.containerd_id = obs.containerd_id or parent.containerd_id
    obs.containerd_namespace = obs.containerd_namespace or parent.containerd_namespace
    obs.runtime_type = choose_runtime_type(parent.runtime_type, obs.runtime_type)
    if parent.containerd_namespace:
        obs.attributes.setdefault("containerd.namespace", parent.containerd_namespace)
    if parent.role == "cni":
        obs.cni_plugin = obs.cni_plugin or parent.cni_plugin
        obs.cni_command = obs.cni_command or parent.cni_command
        obs.cni_netns = obs.cni_netns or parent.cni_netns
        obs.cni_netns_id = obs.cni_netns_id or parent.cni_netns_id
        obs.attributes["startup.phase"] = "sandbox-network-helper"
        obs.attributes["startup.phase.source"] = "parent-cni"
        for key in (
            "cni.ifname",
            "cni.path",
            "cni.container_id",
            "cni.netns.path",
            "cni.netns.dev",
            "cni.netns.ino",
            "cni.netns.id",
            "cni.netns.stat_error",
            "cni.args.K8S_POD_INFRA_CONTAINER_ID",
            "cni.args.K8S_POD_NAMESPACE",
            "cni.args.K8S_POD_NAME",
            "cni.args.K8S_POD_UID",
        ):
            if key in parent.attributes:
                obs.attributes.setdefault(key, parent.attributes[key])


def observation_matches_namespace(obs: ExecObservation, namespaces: set[str] | None) -> bool:
    if not namespaces:
        return True
    if obs.containerd_namespace:
        return obs.containerd_namespace in namespaces
    # CNI plugin execve carries CNI_CONTAINERID rather than a containerd namespace;
    # keep it so the startup-callchain normalizer can still join by sandbox id.
    if obs.role == "cni" and obs.cri_sandbox_id:
        return True
    return False


def choose_runtime_type(current: str, candidate: str) -> str:
    if current in {"", "unknown"}:
        return candidate or "unknown"
    if current == "runc" and candidate in {"kata", "gvisor", "firecracker"}:
        return candidate
    return current


def summarize_events(events: list[dict[str, object]]) -> dict[str, float]:
    enter_events = [event for event in events if event.get("eventType") == "enter"]
    cni = [event for event in enter_events if event.get("role") == "cni"]
    oci = [event for event in enter_events if event.get("role") == "oci"]
    helper = [event for event in enter_events if event.get("role") == "helper" or is_helper_binary(basename(str(event.get("binary", ""))))]
    cri = [event for event in enter_events if event.get("role") == "cri"]
    return {
        "observedExecCount": float(len(enter_events)),
        "observedCriUprobeCount": float(len(cri)),
        "observedCniExecCount": float(len(cni)),
        "observedOciExecCount": float(len(oci)),
        "observedHelperExecCount": float(len(helper)),
    }


def build_bcc_go_uprobe_program(go_uprobes: list[GoUprobeSpec]) -> str:
    functions = ["""
#include <uapi/linux/ptrace.h>
#include <linux/sched.h>
#ifndef PT_REGS_DI
#define PT_REGS_DI(ctx) ((ctx)->di)
#endif
#ifndef PT_REGS_CX
#define PT_REGS_CX(ctx) ((ctx)->cx)
#endif

static int read_go_string(char *dst, int dst_len, void *data, u64 len) {
    if (!data || len == 0) {
        return 0;
    }
    int size = len < (u64)(dst_len - 1) ? (int)len : dst_len - 1;
    if (size <= 0) {
        return 0;
    }
    bpf_probe_read_user(dst, size, data);
    dst[size] = 0;
    return size;
}

static int emit_runpod_request_metadata_from_req(struct pt_regs *ctx, int idx, void *req) {
#ifdef __x86_64__
    u64 id = bpf_get_current_pid_tgid();
    u32 pid = id >> 32;
    u32 tid = (u32)id;
    u64 ts = bpf_ktime_get_ns();
    if (!req) {
        return 0;
    }
    void *config = 0;
    bpf_probe_read_user(&config, sizeof(config), req + 8);
    if (!config) {
        return 0;
    }
    void *metadata = 0;
    bpf_probe_read_user(&metadata, sizeof(metadata), config + 8);
    if (metadata) {
        void *name_data = 0;
        u64 name_len = 0;
        void *uid_data = 0;
        u64 uid_len = 0;
        void *namespace_data = 0;
        u64 namespace_len = 0;
        char value[96];
        bpf_probe_read_user(&name_data, sizeof(name_data), metadata + 8);
        bpf_probe_read_user(&name_len, sizeof(name_len), metadata + 16);
        if (read_go_string(value, sizeof(value), name_data, name_len) > 0) {
            bpf_trace_printk("RP_GO_UPROBE_META %u %u k8s.pod %s\\n", pid, tid, value);
        }
        bpf_probe_read_user(&uid_data, sizeof(uid_data), metadata + 24);
        bpf_probe_read_user(&uid_len, sizeof(uid_len), metadata + 32);
        if (read_go_string(value, sizeof(value), uid_data, uid_len) > 0) {
            bpf_trace_printk("RP_GO_UPROBE_META %u %u k8s.pod_uid %s\\n", pid, tid, value);
        }
        bpf_probe_read_user(&namespace_data, sizeof(namespace_data), metadata + 40);
        bpf_probe_read_user(&namespace_len, sizeof(namespace_len), metadata + 48);
        if (read_go_string(value, sizeof(value), namespace_data, namespace_len) > 0) {
            bpf_trace_printk("RP_GO_UPROBE_META %u %u k8s.namespace %s\\n", pid, tid, value);
        }
    }
    void *runtime_data = 0;
    u64 runtime_len = 0;
    char runtime_value[64];
    bpf_probe_read_user(&runtime_data, sizeof(runtime_data), req + 16);
    bpf_probe_read_user(&runtime_len, sizeof(runtime_len), req + 24);
    if (read_go_string(runtime_value, sizeof(runtime_value), runtime_data, runtime_len) > 0) {
        bpf_trace_printk("RP_GO_UPROBE_META %u %u cri.runtime_handler %s\\n", pid, tid, runtime_value);
    }
#endif
    return 0;
}

