#!/usr/bin/env python3
"""Minimal RuntimePulse CRI/containerd startup probe exporter.

The probe intentionally emits the raw event shape accepted by the Rust
`startup-callchain` collector.  The current implementation uses real kernel
exec/exit tracepoints through bpftrace to attribute CNI plugin binaries, OCI
runtime binaries, Kata/runtime helpers, and selected helper binaries to a
sandbox id whenever that id is present in CNI env or OCI/containerd paths.

It is a small bridge, not a CRI proxy.  Precise Go-function RunPodSandbox
uprobes can be added as a later backend while keeping this JSON contract.
"""
from __future__ import annotations

