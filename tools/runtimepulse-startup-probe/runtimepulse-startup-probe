def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="runtimepulse-startup-probe")
    sub = parser.add_subparsers(dest="command", required=True)
    export = sub.add_parser("export", help="export one RuntimePulse startup-callchain raw-event report")
    export.add_argument("--once", action="store_true", help="compatibility flag; export already captures one window")
    export.add_argument("--duration-ms", type=int, default=int(os.getenv("RUNTIMEPULSE_STARTUP_PROBE_DURATION_MS", "1000")))
    export.add_argument("--bpftrace", default=os.getenv("RUNTIMEPULSE_STARTUP_PROBE_BPFTRACE", "bpftrace"))
    export.add_argument("--cni-bin-dir", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_STARTUP_PROBE_CNI_BIN_DIRS", "")]))
    export.add_argument("--runtime-binary", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_STARTUP_PROBE_RUNTIME_BINARIES", "")]))
    export.add_argument("--include-binary", action="append", default=[])
    export.add_argument("--include-helpers", action="store_true", default=os.getenv("RUNTIMEPULSE_STARTUP_PROBE_INCLUDE_HELPERS", "false").lower() == "true")
    export.add_argument("--enable-go-uprobes", action="store_true", default=env_flag("RUNTIMEPULSE_STARTUP_PROBE_ENABLE_GO_UPROBES"), help="attach high-precision Go uprobes to containerd RunPodSandbox symbols")
    export.add_argument("--containerd-binary", default=os.getenv("RUNTIMEPULSE_STARTUP_PROBE_CONTAINERD_BINARY", shutil.which("containerd") or next((path for path in DEFAULT_CONTAINERD_BINARIES if os.path.exists(path)), "containerd")))
    export.add_argument("--containerd-config", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_CONTAINERD_CONFIG", "")]), help="containerd config.toml used to infer task bundle roots from state/root; may be repeated")
    export.add_argument("--go-uprobe-symbol", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_STARTUP_PROBE_GO_UPROBE_SYMBOLS", "")]), help="containerd RunPodSandbox Go symbol/pattern to attach; may be repeated; prefix regex: for regex")
    export.add_argument("--enable-cni-go-uprobes", action="store_true", default=env_flag("RUNTIMEPULSE_STARTUP_PROBE_ENABLE_CNI_GO_UPROBES"), help="also attach containerd/go-cni setup Go uprobes")
    export.add_argument("--cni-go-uprobe-symbol", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_STARTUP_PROBE_CNI_GO_UPROBE_SYMBOLS", "")]), help="containerd CNI setup Go symbol/pattern to attach; may be repeated; prefix regex: for regex")
    export.add_argument("--enable-runtime-go-uprobes", action="store_true", default=env_flag("RUNTIMEPULSE_STARTUP_PROBE_ENABLE_RUNTIME_GO_UPROBES"), help="also attach OCI/Kata runtime shim Go uprobes")
    export.add_argument("--runtime-uprobe-binary", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_STARTUP_PROBE_RUNTIME_UPROBE_BINARIES", "")]), help="runtime shim binary for Go uprobe discovery; may be repeated")
    export.add_argument("--runtime-go-uprobe-symbol", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_STARTUP_PROBE_RUNTIME_GO_UPROBE_SYMBOLS", "")]), help="OCI/Kata runtime Go symbol/pattern to attach; may be repeated; prefix regex: for regex")
    export.add_argument("--enable-go-uretprobes", action="store_true", default=env_flag("RUNTIMEPULSE_STARTUP_PROBE_ENABLE_GO_URETPROBES"), help="experimental: also attach Go return probes for real function exit timestamps; disabled by default because some Go/runtime combinations cannot unwind safely")
    export.add_argument("--sandbox-id", default=os.getenv("RUNTIMEPULSE_STARTUP_PROBE_SANDBOX_ID", ""))
    export.add_argument("--containerd-namespace", action="append", default=split_csv([os.getenv("RUNTIMEPULSE_STARTUP_PROBE_CONTAINERD_NAMESPACES", "")]), help="only keep OCI/runtime execs from these containerd namespaces; CNI execs are kept by CNI_CONTAINERID")
    export.add_argument("--runtime-type", default=os.getenv("RUNTIMEPULSE_STARTUP_PROBE_RUNTIME_TYPE", ""))
    export.add_argument("--source", default="runtimepulse-startup-probe")
    export.add_argument("--argv-slots", type=int, default=16)
    export.add_argument("--env-slots", type=int, default=32)
    export.add_argument("--strlen", type=int, default=int(os.getenv("RUNTIMEPULSE_STARTUP_PROBE_STRLEN", "1024")))
    export.add_argument("--from-bpftrace-log", help=argparse.SUPPRESS)
    export.add_argument(
        "--ready-file",
        default=os.getenv("RUNTIMEPULSE_STARTUP_PROBE_READY_FILE", ""),
        help="write this file after bpftrace reports probes are attached",
    )
    export.add_argument(
        "--no-group-by-sandbox",
        action="store_true",
        default=os.getenv("RUNTIMEPULSE_STARTUP_PROBE_NO_GROUP_BY_SANDBOX", "false").lower()
        == "true",
        help="emit one legacy report for the whole capture window instead of one report per sandbox id",
    )
    export.set_defaults(func=export_command)

    test_cmd = sub.add_parser("self-test", help="run parser self-test")
    test_cmd.set_defaults(func=lambda _args: self_test())
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
