RUNTIMEPULSE_COLLECTOR_NODE_ID=runtimepulse-host
RUNTIMEPULSE_COLLECTOR_CLUSTER_ID=runtimepulse-local
RUNTIMEPULSE_COLLECTOR_INTERVAL_MS=5000
RUNTIMEPULSE_LOCAL_REPORT_URL=http://127.0.0.1:9091/api/local/ingest
RUNTIMEPULSE_HOST_AGENT_FLUSH_MS=1000
RUNTIMEPULSE_HOST_AGENT_QUEUE_CAPACITY=512
RUNTIMEPULSE_HOST_AGENT_SOURCES=procfs,psi,cgroupfs,containerd-inventory,containerd-events,cri-events,containerd-sandbox-cgroupfs,image-cache,profile-report,perf,ebpf
# Optional when a real snapshotter/cache exporter writes RuntimePulse JSON or JSONL:
RUNTIMEPULSE_IMAGE_CACHE_REPORT_PATH=/var/lib/runtimepulse/image-cache-report.json
# Optional when this node uses CRI + containerd directly. This enables the
# lightweight runc/Kata sandbox startup correlator without a CRI proxy:
# RUNTIMEPULSE_HOST_AGENT_SOURCES=procfs,psi,cgroupfs,containerd-inventory,containerd-events,cri-events,cri-startup-trace,startup-callchain,containerd-sandbox-cgroupfs,kata,sandbox-reconcile,image-cache
# RUNTIMEPULSE_CRI_EVENTS_CMD=crictl events --output json
# Optional when an external uprobe/eBPF startup call-chain exporter is available.
# Prefer the spool hook: `runtimepulse-startup-probe.service` continuously
# captures short-lived RunPod/CNI/runtime events and atomically writes completed
# JSON reports here; `runtimepulse-startup-callchain.service` consumes the spool.
RUNTIMEPULSE_STARTUP_CALLCHAIN_SPOOL_DIR=/var/lib/runtimepulse/startup-callchain
# The bundled minimal exporter uses bpftrace exec/exit tracepoints and should
# usually run through sudo/root on the host.
# For eBPF exec tracking, prefer running `runtimepulse-collector host-startup-callchain`
# as a dedicated systemd unit instead of inside the multi-source host-agent.  The
# probe tracks containerd's process tree, automatically refreshes the target when
# containerd restarts, and routes only CNI/plugin helper subtrees plus runtime
# shim/runtime subtrees into sandbox startup reports.
RUNTIMEPULSE_STARTUP_CALLCHAIN_INTERVAL_MS=1000
RUNTIMEPULSE_STARTUP_PROBE_FLUSH_INTERVAL_MS=1000
RUNTIMEPULSE_STARTUP_PROBE_FLUSH_IDLE_MS=2000
RUNTIMEPULSE_STARTUP_PROBE_CONTAINERD_TREE=true
RUNTIMEPULSE_STARTUP_PROBE_CONTAINERD_NAMESPACES=k8s.io
RUNTIMEPULSE_STARTUP_PROBE_INCLUDE_HELPERS=true
RUNTIMEPULSE_STARTUP_PROBE_ENABLE_GO_UPROBES=true
RUNTIMEPULSE_HOST_AGENT_SPOOL_DIR=/var/lib/runtimepulse/host-agent-spool
RUNTIMEPULSE_HOST_AGENT_SPOOL_MAX_FILES=256
# Point this at the CRI/containerd socket. When Docker collectors are enabled,
# do not collect Docker's internal containerd `moby` namespace through the
# containerd sources, otherwise Docker containers are shown twice.
RUNTIMEPULSE_CONTAINERD_SOCKET=/run/containerd/containerd.sock
RUNTIMEPULSE_CONTAINERD_NAMESPACES=k8s.io
RUNTIMEPULSE_CGROUP_ROOT=/sys/fs/cgroup
