RUNTIMEPULSE_COLLECTOR_NODE_ID=rust-node-a
RUNTIMEPULSE_COLLECTOR_CLUSTER_ID=runtimepulse-local
RUNTIMEPULSE_COLLECTOR_INTERVAL_MS=5000
RUNTIMEPULSE_LOCAL_REPORT_URL=http://127.0.0.1:9091/api/local/ingest
RUNTIMEPULSE_HOST_AGENT_FLUSH_MS=1000
RUNTIMEPULSE_HOST_AGENT_QUEUE_CAPACITY=512
RUNTIMEPULSE_HOST_AGENT_SOURCES=procfs,cgroupfs,docker-inventory,docker-events,docker-sandbox-cgroupfs,image-cache
# Optional when a real snapshotter/cache exporter writes RuntimePulse JSON or JSONL:
RUNTIMEPULSE_IMAGE_CACHE_REPORT_PATH=/var/lib/runtimepulse/image-cache-report.json
# Optional when this node uses CRI + containerd directly. This enables the
# lightweight runc/Kata sandbox startup correlator without a CRI proxy:
# RUNTIMEPULSE_HOST_AGENT_SOURCES=procfs,psi,cgroupfs,containerd-inventory,containerd-events,cri-events,cri-startup-trace,startup-callchain,containerd-sandbox-cgroupfs,kata,sandbox-reconcile,image-cache
# RUNTIMEPULSE_CRI_EVENTS_CMD=crictl events --output json
# Optional when an external uprobe/eBPF startup call-chain exporter is available:
# RUNTIMEPULSE_STARTUP_CALLCHAIN_REPORT_PATH=/var/lib/runtimepulse/startup-callchain.jsonl
# RUNTIMEPULSE_STARTUP_CALLCHAIN_REPORT_CMD=/usr/local/bin/runtimepulse-startup-probe export --once
RUNTIMEPULSE_HOST_AGENT_SPOOL_DIR=/var/lib/runtimepulse/host-agent-spool
RUNTIMEPULSE_HOST_AGENT_SPOOL_MAX_FILES=256
RUNTIMEPULSE_CONTAINERD_SOCKET=/run/containerd/containerd.sock
RUNTIMEPULSE_CONTAINERD_NAMESPACES=
RUNTIMEPULSE_CGROUP_ROOT=/sys/fs/cgroup
